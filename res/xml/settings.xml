           android:key="side_panel_sensitivity"
           android:title="Trigger Sensitivity (Width)"
           android:summary="%sdp"
           android:defaultValue="20"
           android:min="5"
           android:max="50" />
       <juloo.keyboard2.prefs.IntSlideBarPreference
           android:key="side_panel_transparency"
           android:title="Trigger Transparency (Visual Debug)"
           android:summary="%s%%"
           android:defaultValue="0"
           android:min="0"
           android:max="100" />
   </PreferenceScreen>
   <PreferenceScreen android:title="Backup &amp; Restore" android:summary="Save or restore keyboard settings">
       <intent android:action="android.intent.action.MAIN" android:targetPackage="juloo.keyboard2" android:targetClass="juloo.keyboard2.BackupRestoreActivity"/>
   </PreferenceScreen>
   <PreferenceScreen android:title="@string/pref_category_emoji">
       <SwitchPreference android:key="emoji_show_recent" android:title="@string/pref_emoji_show_recent" android:defaultValue="true"/>
       <SwitchPreference android:key="emoji_show_kaomoji" android:title="@string/pref_emoji_show_kaomoji" android:defaultValue="true"/>
       <SwitchPreference android:key="emoji_vibrate" android:title="@string/pref_emoji_vibrate" android:defaultValue="true"/>
       <SwitchPreference android:key="emoji_sound" android:title="@string/pref_emoji_sound" android:defaultValue="false"/>
       <SwitchPreference android:key="emoji_long_press_name" android:title="@string/pref_emoji_long_press_name" android:defaultValue="true"/>
       <SwitchPreference android:key="emoji_favorites_enabled" android:title="@string/pref_emoji_favorites_enabled" android:defaultValue="true"/>
       <SwitchPreference android:key="emoji_long_press_add_favorite" android:title="@string/pref_emoji_long_press_add_favorite" android:defaultValue="false" android:dependency="emoji_favorites_enabled"/>
       <SwitchPreference android:key="emoji_favorites_first" android:title="@string/pref_emoji_favorites_first" android:defaultValue="false" android:dependency="emoji_favorites_enabled"/>
       <juloo.keyboard2.prefs.SlideBarPreference android:key="emoji_size_factor" android:title="@string/pref_emoji_size_factor" android:summary="%s" android:defaultValue="1.0" min="0.5" max="2.0"/>
       <juloo.keyboard2.prefs.SlideBarPreference android:key="emoji_kaomoji_size_factor" android:title="@string/pref_emoji_kaomoji_size_factor" android:summary="%s" android:defaultValue="1.0" min="0.5" max="2.0"/>
