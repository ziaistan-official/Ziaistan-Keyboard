  <PreferenceScreen android:title="@string/pref_category_clipboard">
    <SwitchPreference
        android:key="clipboard_history_enabled"
        android:title="@string/pref_clipboard_history_title"
        android:summary="@string/pref_clipboard_history_summary"
        android:defaultValue="true"/>
    <ListPreference
        android:key="clipboard_history_duration"
        android:title="@string/pref_clipboard_history_duration"
        android:summary="%s"
        android:defaultValue="2147483647"
        android:entries="@array/pref_clipboard_duration_entries"
        android:entryValues="@array/pref_clipboard_duration_values"
        android:dependency="clipboard_history_enabled"/>
    <CheckBoxPreference
        android:key="clipboard_actions_on_top"
        android:title="@string/pref_clipboard_actions_on_top_title"
        android:summary="@string/pref_clipboard_actions_on_top_summary"
        android:defaultValue="false"/>
    <SwitchPreference
        android:key="enable_typing_history"
        android:title="Enable Typing History"
        android:summary="Record typing sessions to prevent data loss"
        android:defaultValue="true"/>
   </PreferenceScreen>
   <PreferenceScreen android:title="Password Manager">
       <intent android:action="android.intent.action.MAIN" android:targetPackage="juloo.keyboard2" android:targetClass="juloo.keyboard2.passwordmanager.ui.PasswordManagerActivity"/>
   </PreferenceScreen>
   <PreferenceScreen android:title="Side Panel Navigation">
       <intent android:action="android.intent.action.MAIN" android:targetPackage="juloo.keyboard2" android:targetClass="juloo.keyboard2.SidePanelSettingsActivity"/>
   </PreferenceScreen>
   <PreferenceScreen android:title="Side Panel Tweaks" android:summary="Adjust sensitivity and appearance">
