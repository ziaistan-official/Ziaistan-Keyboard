<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
  <PreferenceScreen android:title="@string/pref_category_layout">
    <juloo.keyboard2.prefs.LayoutsPreference/>
    <PreferenceScreen android:title="@string/pref_extra_keys_title">
      <PreferenceScreen android:title="@string/pref_extra_keys_custom">
        <juloo.keyboard2.prefs.CustomExtraKeysPreference/>
      </PreferenceScreen>
      <juloo.keyboard2.prefs.ExtraKeysPreference android:title="@string/pref_extra_keys_internal"/>
    </PreferenceScreen>
    <ListPreference android:key="number_row" android:title="@string/pref_number_row_title" android:summary="%s" android:defaultValue="symbols" android:entries="@array/pref_show_number_row_entries" android:entryValues="@array/pref_show_number_row_values"/>
    <ListPreference android:key="show_numpad" android:title="@string/pref_show_numpad_title" android:summary="%s" android:defaultValue="1" android:entries="@array/pref_show_numpad_entries" android:entryValues="@array/pref_show_numpad_values"/>
    <ListPreference android:key="numpad_layout" android:title="@string/pref_numpad_layout" android:summary="%s" android:defaultValue="high_first" android:entries="@array/pref_numpad_layout_entries" android:entryValues="@array/pref_numpad_layout_values"/>
    <SwitchPreference android:key="show_emoji_key" android:title="@string/pref_show_emoji_key" android:defaultValue="true"/>
    <SwitchPreference android:key="show_language_key" android:title="@string/pref_show_language_key" android:defaultValue="true"/>
    <SwitchPreference android:key="show_number_row_password" android:title="@string/pref_show_number_row_password" android:defaultValue="true"/>
    <SwitchPreference android:key="show_clipboard_suggestion" android:title="@string/pref_show_clipboard_suggestion" android:defaultValue="true"/>
  </PreferenceScreen>
  <PreferenceScreen android:title="@string/pref_category_typing">
    <SwitchPreference android:key="vibrate_on_space" android:title="@string/pref_vibrate_on_space" android:defaultValue="true" android:dependency="vibrate_custom"/>
    <SwitchPreference android:key="vibrate_on_delete" android:title="@string/pref_vibrate_on_delete" android:defaultValue="true" android:dependency="vibrate_custom"/>
    <SwitchPreference android:key="vibrate_on_action" android:title="@string/pref_vibrate_on_action" android:defaultValue="true" android:dependency="vibrate_custom"/>
    <SwitchPreference android:key="sound_on_space" android:title="@string/pref_sound_on_space" android:defaultValue="true" android:dependency="sound_on_keypress"/>
    <SwitchPreference android:key="sound_on_delete" android:title="@string/pref_sound_on_delete" android:defaultValue="true" android:dependency="sound_on_keypress"/>
    <SwitchPreference android:key="sound_on_action" android:title="@string/pref_sound_on_action" android:defaultValue="true" android:dependency="sound_on_keypress"/>
    <ListPreference android:key="swipe_dist" android:title="@string/pref_swipe_dist_title" android:summary="@string/pref_swipe_dist_summary" android:defaultValue="15" android:entries="@array/pref_swipe_dist_entries" android:entryValues="@array/pref_swipe_dist_values"/>
    <ListPreference android:key="circle_sensitivity" android:title="@string/pref_circle_sensitivity_title" android:summary="%s" android:defaultValue="2" android:entries="@array/pref_circle_sensitivity_entries" android:entryValues="@array/pref_circle_sensitivity_values"/>
    <ListPreference android:key="slider_sensitivity" android:title="@string/pref_slider_sensitivity_title" android:summary="%s" android:defaultValue="15" android:entries="@array/pref_slider_sensitivity_entries" android:entryValues="@array/pref_slider_sensitivity_values"/>
    <juloo.keyboard2.prefs.IntSlideBarPreference android:key="longpress_timeout" android:title="@string/pref_long_timeout_title" android:summary="%sms" android:defaultValue="600" min="50" max="2000"/>
    <CheckBoxPreference android:key="keyrepeat_enabled" android:title="@string/pref_keyrepeat_enabled" android:defaultValue="true"/>
    <juloo.keyboard2.prefs.IntSlideBarPreference android:key="longpress_interval" android:dependency="keyrepeat_enabled" android:title="@string/pref_long_interval_title" android:summary="%sms" android:defaultValue="25" min="5" max="100"/>
    <CheckBoxPreference android:key="lock_double_tap" android:title="@string/pref_lock_double_tap_title" android:summary="@string/pref_lock_double_tap_summary" android:defaultValue="true"/>
    <CheckBoxPreference android:key="vibrate_custom" android:title="@string/pref_vibrate_custom" android:defaultValue="false"/>
    <juloo.keyboard2.prefs.IntSlideBarPreference android:dependency="vibrate_custom" android:key="vibrate_duration" android:title="@string/pref_vibrate_duration_title" android:summary="%sms" android:defaultValue="20" min="0" max="100"/>
    <SwitchPreference android:key="vibrate_on_correction" android:title="Vibrate on correction" android:summary="Vibrate when text is auto-corrected" android:defaultValue="false"/>
    <SwitchPreference android:key="sound_on_keypress" android:title="Sound on keypress" android:defaultValue="false"/>
  </PreferenceScreen>
  <PreferenceScreen android:title="@string/pref_category_behavior">
    <SwitchPreference android:key="popup_on_keypress" android:title="Popup on keypress" android:summary="Show a popup on keypress" android:defaultValue="true"/>
    <SwitchPreference android:key="circle_gestures" android:title="Circle Gestures" android:summary="Enable circle gestures" android:defaultValue="true"/>
    <SwitchPreference android:key="encapsulation" android:title="Encapsulation" android:summary="Enable encapsulation" android:defaultValue="true"/>
    <SwitchPreference android:key="case_conversion_and_formatting" android:title="Case Conversion and Formatting" android:summary="Enable case conversion and formatting" android:defaultValue="true"/>
    <SwitchPreference android:key="swipe_space_cursor" android:title="@string/pref_swipe_space_cursor" android:defaultValue="true"/>
    <SwitchPreference android:key="swipe_delete_word" android:title="@string/pref_swipe_delete_word" android:defaultValue="true"/>
    <SwitchPreference android:key="long_press_space_cursor" android:title="@string/pref_long_press_space_cursor" android:defaultValue="true"/>
    <SwitchPreference android:key="delete_swallows_space" android:title="@string/pref_delete_swallows_space" android:defaultValue="false"/>
    <SwitchPreference android:key="smart_punctuation" android:title="@string/pref_smart_punctuation" android:defaultValue="false"/>
    <SwitchPreference android:key="auto_switch_back_emoji" android:title="@string/pref_auto_switch_back_emoji" android:defaultValue="true"/>
    <SwitchPreference android:key="auto_add_user_words" android:title="@string/pref_auto_add_user_words" android:defaultValue="false"/>
    <SwitchPreference android:key="block_offensive_words" android:title="@string/pref_block_offensive_words" android:defaultValue="true"/>
    <SwitchPreference android:key="incognito_mode" android:title="@string/pref_incognito_mode" android:summary="@string/pref_incognito_mode_summary" android:defaultValue="false"/>
    <CheckBoxPreference android:key="autocapitalisation" android:title="@string/pref_autocapitalisation_title" android:summary="@string/pref_autocapitalisation_summary" android:defaultValue="true"/>
    <CheckBoxPreference android:key="enable_suggestions" android:title="@string/pref_enable_suggestions_title" android:summary="@string/pref_enable_suggestions_summary" android:defaultValue="true"/>
    <CheckBoxPreference android:key="suggestion_strip_on_top" android:title="@string/pref_suggestion_strip_on_top_title" android:summary="@string/pref_suggestion_strip_on_top_summary" android:defaultValue="true" android:dependency="enable_suggestions"/>
    <CheckBoxPreference android:key="switch_input_immediate" android:title="@string/pref_switch_input_immediate_title" android:summary="@string/pref_switch_input_immediate_summary" android:defaultValue="false"/>
    <PreferenceScreen
        android:title="Custom Dictionary"
        android:summary="Manage custom dictionary words">
        <intent android:action="juloo.keyboard2.CUSTOM_DICTIONARY_SETTINGS"/>
    </PreferenceScreen>
    <PreferenceScreen
        android:title="Auto Suggestions Customizations"
        android:summary="Change priority order and colors">
        <intent android:action="juloo.keyboard2.AUTO_SUGGESTION_SETTINGS"/>
    </PreferenceScreen>
    <ListPreference android:key="number_entry_layout" android:title="@string/pref_number_entry_title" android:summary="%s" android:defaultValue="pin" android:entries="@array/pref_number_entry_entries" android:entryValues="@array/pref_number_entry_values"/>
    <SwitchPreference android:key="swap_enter_action_key" android:title="Swap Enter and Action/Emoji keys" android:defaultValue="false"/>
    <SwitchPreference android:key="double_space_period" android:title="Double space period" android:summary="Insert a period when double tapping space" android:defaultValue="false"/>
    <SwitchPreference android:key="auto_correct_space" android:title="Auto-correct on space" android:summary="Apply auto-correction when pressing space" android:defaultValue="true"/>
    <SwitchPreference android:key="revert_on_backspace" android:title="Revert on backspace" android:summary="Revert auto-correction when pressing backspace" android:defaultValue="true"/>
    <SwitchPreference android:key="space_after_suggestion" android:title="Space after suggestion" android:summary="Insert a space after selecting a suggestion" android:defaultValue="true"/>
    <SwitchPreference android:key="learn_new_words" android:title="Learn new words" android:summary="Learn new words from typing" android:defaultValue="true"/>
    <SwitchPreference android:key="shortcut_learn_d" android:title="Shortcut: Learn (d)" android:summary="Enable 'd' on selection to learn word" android:defaultValue="true"/>
    <SwitchPreference android:key="shortcut_translate_t" android:title="Shortcut: Translate (t)" android:summary="Enable 't' on selection to translate" android:defaultValue="true"/>
    <SwitchPreference android:key="shortcut_keep_k" android:title="Shortcut: Keep (k)" android:summary="Enable 'k' on selection to save to Keep" android:defaultValue="true"/>
    <SwitchPreference android:key="shortcut_obsidian_o" android:title="Shortcut: Obsidian (o)" android:summary="Enable 'o' on selection to save to Obsidian" android:defaultValue="true"/>
    <SwitchPreference android:key="shortcut_chrome_c" android:title="Shortcut: Search (c)" android:summary="Enable 'c' on selection to search in Chrome" android:defaultValue="true"/>
    <SwitchPreference android:key="format_bold_b" android:title="Shortcut: Bold (b)" android:summary="Enable 'b' on selection to bold text" android:defaultValue="true"/>
    <SwitchPreference android:key="format_italic_i" android:title="Shortcut: Italic (i)" android:summary="Enable 'i' on selection to italicize text" android:defaultValue="true"/>
    <SwitchPreference android:key="format_upper_u" android:title="Shortcut: Uppercase (u)" android:summary="Enable 'u' on selection to uppercase text" android:defaultValue="true"/>
    <SwitchPreference android:key="format_lower_l" android:title="Shortcut: Lowercase (l)" android:summary="Enable 'l' on selection to lowercase text" android:defaultValue="true"/>
    <SwitchPreference android:key="format_sentence_s" android:title="Shortcut: Sentence case (s)" android:summary="Enable 's' on selection to sentence case text" android:defaultValue="true"/>
    <PreferenceCategory android:title="Typing HUD">
        <SwitchPreference android:key="enable_typing_hud" android:title="@string/pref_enable_typing_hud" android:summary="@string/pref_enable_typing_hud_summary" android:defaultValue="false"/>
        <juloo.keyboard2.prefs.IntSlideBarPreference android:key="typing_hud_duration" android:title="@string/pref_typing_hud_duration" android:summary="%sms" android:defaultValue="3000" min="500" max="10000" android:dependency="enable_typing_hud"/>
        <EditTextPreference android:key="typing_hud_bg_color" android:title="@string/pref_typing_hud_bg_color" android:defaultValue="CC000000" android:dependency="enable_typing_hud"/>
        <EditTextPreference android:key="typing_hud_txt_color" android:title="@string/pref_typing_hud_txt_color" android:defaultValue="FFFFFFFF" android:dependency="enable_typing_hud"/>
        <juloo.keyboard2.prefs.IntSlideBarPreference android:key="typing_hud_txt_size" android:title="@string/pref_typing_hud_txt_size" android:summary="%ssp" android:defaultValue="18" min="10" max="40" android:dependency="enable_typing_hud"/>
    </PreferenceCategory>
  </PreferenceScreen>
  <PreferenceScreen android:title="@string/pref_category_style">
    <ListPreference android:key="app_theme" android:title="@string/pref_app_theme" android:summary="%s" android:defaultValue="system" android:entries="@array/pref_app_theme_entries" android:entryValues="@array/pref_app_theme_values"/>
