    <SwitchPreference android:key="show_sublabels" android:title="Show secondary characters" android:defaultValue="true"/>
    <SwitchPreference android:key="colored_sublabels" android:title="@string/pref_colored_sublabels" android:defaultValue="false"/>
    <SwitchPreference android:key="draw_key_borders" android:title="@string/pref_draw_key_borders" android:defaultValue="false"/>
    <PreferenceScreen
        android:title="Live Layout Customization"
        android:summary="Premium real-time keyboard layout editor">
        <intent android:action="juloo.keyboard2.LIVE_LAYOUT_CUSTOMIZATION"/>
    </PreferenceScreen>
    <SwitchPreference android:key="disable_animations" android:title="@string/pref_disable_animations" android:defaultValue="false"/>
    <SwitchPreference android:key="show_gesture_trail" android:title="@string/pref_show_gesture_trail" android:defaultValue="true"/>
    <ListPreference android:key="gesture_trail_style" android:title="@string/pref_gesture_trail_style" android:summary="%s" android:defaultValue="0" android:entries="@array/pref_gesture_trail_style_entries" android:entryValues="@array/pref_gesture_trail_style_values" android:dependency="show_gesture_trail"/>
    <juloo.keyboard2.prefs.SlideBarPreference android:key="gesture_trail_width_factor" android:title="@string/pref_gesture_trail_width_factor" android:summary="%s" android:defaultValue="1.0" min="0.5" max="3.0" android:dependency="show_gesture_trail"/>
    <juloo.keyboard2.prefs.SlideBarPreference android:key="gesture_trail_length_factor" android:title="@string/pref_gesture_trail_length_factor" android:summary="%s" android:defaultValue="1.0" min="0.5" max="3.0" android:dependency="show_gesture_trail"/>
    <SwitchPreference android:key="force_landscape_fullscreen" android:title="@string/pref_force_landscape_fullscreen" android:defaultValue="false"/>
    <SwitchPreference android:key="use_system_font" android:title="Use system font" android:defaultValue="false"/>
    <juloo.keyboard2.prefs.IntSlideBarPreference android:key="label_brightness" android:title="@string/pref_label_brightness" android:summary="%s%%" android:defaultValue="100" min="50" max="100"/>
    <juloo.keyboard2.prefs.IntSlideBarPreference android:key="keyboard_opacity" android:title="@string/pref_keyboard_opacity" android:summary="%s%%" android:defaultValue="100" min="0" max="100"/>
    <juloo.keyboard2.prefs.IntSlideBarPreference android:key="key_opacity" android:title="@string/pref_key_opacity" android:summary="%s%%" android:defaultValue="100" min="0" max="100"/>
    <juloo.keyboard2.prefs.IntSlideBarPreference android:key="key_activated_opacity" android:title="@string/pref_key_activated_opacity" android:summary="%s%%" android:defaultValue="100" min="0" max="100"/>
    <PreferenceScreen android:title="@string/pref_margin_bottom_title">
      <juloo.keyboard2.prefs.IntSlideBarPreference android:key="margin_bottom_portrait" android:title="@string/pref_portrait" android:summary="%sdp" android:defaultValue="0" min="0" max="100"/>
      <juloo.keyboard2.prefs.IntSlideBarPreference android:key="margin_bottom_landscape" android:title="@string/pref_landscape" android:summary="%sdp" android:defaultValue="3" min="0" max="100"/>
      <juloo.keyboard2.prefs.IntSlideBarPreference android:key="margin_bottom_portrait_unfolded" android:title="@string/pref_portrait_unfolded" android:summary="%sdp" android:defaultValue="7" min="0" max="100"/>
      <juloo.keyboard2.prefs.IntSlideBarPreference android:key="margin_bottom_landscape_unfolded" android:title="@string/pref_landscape_unfolded" android:summary="%sdp" android:defaultValue="3" min="0" max="100"/>
    </PreferenceScreen>
    <PreferenceScreen android:title="@string/pref_keyboard_height_title">
      <juloo.keyboard2.prefs.IntSlideBarPreference android:key="keyboard_height" android:title="@string/pref_portrait" android:summary="%s%%" android:defaultValue="20" min="10" max="100"/>
      <juloo.keyboard2.prefs.IntSlideBarPreference android:key="keyboard_height_landscape" android:title="@string/pref_landscape" android:summary="%s%%" android:defaultValue="20" min="20" max="65"/>
      <juloo.keyboard2.prefs.IntSlideBarPreference android:key="keyboard_height_unfolded" android:title="@string/pref_portrait_unfolded" android:summary="%s%%" android:defaultValue="35" min="10" max="50"/>
      <juloo.keyboard2.prefs.IntSlideBarPreference android:key="keyboard_height_landscape_unfolded" android:title="@string/pref_landscape_unfolded" android:summary="%s%%" android:defaultValue="50" min="20" max="65"/>
    </PreferenceScreen>
    <PreferenceScreen android:title="@string/pref_horizontal_margin_title">
      <juloo.keyboard2.prefs.IntSlideBarPreference android:key="horizontal_margin_portrait" android:title="@string/pref_portrait" android:summary="%sdp" android:defaultValue="15" min="0" max="30"/>
