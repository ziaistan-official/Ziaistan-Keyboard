       <juloo.keyboard2.prefs.IntSlideBarPreference android:key="emoji_columns_landscape" android:title="@string/pref_emoji_columns_landscape" android:summary="%s" android:defaultValue="10" min="5" max="20"/>
       <juloo.keyboard2.prefs.IntSlideBarPreference android:key="emoji_history_size" android:title="@string/pref_emoji_history_size" android:summary="%s" android:defaultValue="50" min="10" max="100"/>
