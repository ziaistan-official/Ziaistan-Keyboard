           <intent android:action="juloo.keyboard2.CLEAR_EMOJI_HISTORY"/>
       </PreferenceScreen>
       <PreferenceScreen android:title="@string/pref_emoji_clear_favorites" android:summary="@string/pref_emoji_clear_favorites_summary" android:dependency="emoji_favorites_enabled">
           <intent android:action="juloo.keyboard2.CLEAR_EMOJI_FAVORITES"/>
       </PreferenceScreen>
   </PreferenceScreen>
</PreferenceScreen>
