<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer light glow (simulates embossed top-left highlight) -->
    <item>
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="#4DFFFFFF" />
        </shape>
    </item>

    <!-- Inner shadow (simulates embossed bottom-right depth) -->
    <item android:top="2dp" android:left="2dp">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="#4D000000" />
        </shape>
    </item>

    <!-- Main button surface -->
    <item android:top="2dp" android:left="2dp" android:bottom="2dp" android:right="2dp">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="?attr/colorKey" />
        </shape>
    </item>
</layer-list>
