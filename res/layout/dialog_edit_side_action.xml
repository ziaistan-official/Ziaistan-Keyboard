<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configured Actions"
        android:textStyle="bold"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Configured Actions"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_copy_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Copy From..."
            style="?android:attr/buttonBarButtonStyle"
            android:textSize="12sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/list_configured_actions"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="?android:attr/colorBackground" />

    <Button
        android:id="@+id/btn_add_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Add Selection Action" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fast Swipe Action"
        android:textStyle="bold"
        android:paddingTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/label_fast_action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="None"
            android:padding="8dp"
            android:background="?android:attr/colorBackground" />

        <Button
            android:id="@+id/btn_assign_fast_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assign" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tab Glyph (Nav Bar Icon)"
        android:textStyle="bold"
        android:paddingTop="8dp" />

    <EditText
        android:id="@+id/input_tab_glyph"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter icon character" />

    <LinearLayout
        android:id="@+id/editor_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="16dp"
        android:background="?android:attr/colorBackground">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Action Type"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_action_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <LinearLayout
            android:id="@+id/container_global_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Action"
                android:paddingTop="8dp" />

            <Spinner
                android:id="@+id/spinner_global_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/container_app_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App / Activity"
                android:paddingTop="8dp" />

            <Spinner
                android:id="@+id/spinner_app_selection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
        </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom Label (Optional)"
            android:paddingTop="16dp" />

        <EditText
            android:id="@+id/input_custom_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. My Action" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:paddingTop="16dp">

            <Button
                android:id="@+id/btn_cancel_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                style="?android:attr/buttonBarButtonStyle"/>

            <Button
                android:id="@+id/btn_save_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add"
                style="?android:attr/buttonBarButtonStyle"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
