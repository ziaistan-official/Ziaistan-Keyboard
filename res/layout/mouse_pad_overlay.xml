<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_mouse_pad"
    android:padding="2dp">


    <LinearLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/transparent"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/mouse_pad_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mouse Pad"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/cog_outline"
            android:padding="6dp"
            android:contentDescription="Settings"
            android:tint="?android:attr/textColorPrimary" />

        <ImageButton
            android:id="@+id/btn_minimize"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:rotation="45"
            android:contentDescription="Minimize"
            android:tint="?android:attr/textColorPrimary" />


        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close"
            android:tint="?android:attr/textColorPrimary" />

    </LinearLayout>


    <FrameLayout
        android:layout_width="360px"
        android:layout_height="480px"
        android:background="#00000000">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_mouse_pad_track_surface" />

        <TextView
            android:id="@+id/mouse_pad_instructions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="16dp"
            android:text="Tap: Click • 2-Tap: Right Click"
            android:textColor="#00FFFF"
            android:shadowColor="#0000FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="5"
            android:textSize="12sp" />


        <View
            android:id="@+id/trackpad_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="48dp"
            android:clickable="true"
            android:focusable="true" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:background="#333333">

            <Button
                android:id="@+id/btn_left_click"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:text="Left"
                android:textColor="#00FFFF"
                android:textSize="12sp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#00FFFF"/>

            <ImageButton
                android:id="@+id/btn_magnifier_toggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:layout_margin="4dp"
                android:background="@drawable/bg_mouse_pad_fab"
                android:src="@drawable/ic_magnifier"
                android:padding="8dp"
                android:contentDescription="Toggle Magnifier"
                android:tint="#00FFFF" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#00FFFF"/>

            <Button
                android:id="@+id/btn_right_click"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:text="Right"
                android:textColor="#00FFFF"
                android:textSize="12sp" />
        </LinearLayout>


        <ImageView
            android:id="@+id/resize_handle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|end"
            android:src="@android:drawable/ic_menu_crop"
            android:tint="#00FFFF"
            android:clickable="true"
            android:focusable="true" />
    </FrameLayout>

</LinearLayout>
