<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">


    <juloo.keyboard2.AudioVisualizationView
        android:id="@+id/voice_waveform_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp">

        <TextView
            android:id="@+id/voice_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_tap_to_speak"
            android:textColor="#00D9FF"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/voice_transcription_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <ScrollView
                android:id="@+id/voice_suggestions_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:background="#88000000">
                <LinearLayout
                    android:id="@+id/voice_suggestions_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"/>
            </ScrollView>
        </FrameLayout>


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/mic_pulse_bg"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/mic_orb_bg"
                android:alpha="0.3"
                android:layout_gravity="center"/>

            <ImageButton
                android:id="@+id/voice_mic_button"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/ic_mic"
                android:background="@null"
                android:scaleType="centerInside"
                android:tint="#00D9FF"
                android:layout_gravity="center"
                android:contentDescription="Microphone"/>
        </FrameLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <ImageButton
                android:id="@+id/voice_undo_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="@drawable/btn_neon"
                android:tint="#00D9FF"
                android:padding="12dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="Undo"/>

            <ImageButton
                android:id="@+id/voice_close_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="@drawable/btn_neon"
                android:tint="#00D9FF"
                android:padding="12dp"
                android:contentDescription="Close"/>

            <ImageButton
                android:id="@+id/voice_redo_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_rotate"
                android:background="@drawable/btn_neon"
                android:tint="#00D9FF"
                android:padding="12dp"
                android:layout_marginStart="16dp"
                android:contentDescription="Redo"/>

            <ImageButton
                android:id="@+id/voice_settings_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_preferences"
                android:background="@drawable/btn_neon"
                android:tint="#00D9FF"
                android:padding="12dp"
                android:layout_marginStart="16dp"
                android:contentDescription="Settings"/>

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/voice_key_cursor_left"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="&lt;"
                android:textColor="#00D9FF"
                android:background="@drawable/btn_neon"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/voice_key_word_back"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="50dp"
                android:layout_height="40dp"
                android:text="&lt;&lt;"
                android:textColor="#00D9FF"
                android:background="@drawable/btn_neon"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/voice_key_backspace"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="⌫"
                android:textSize="18sp"
                android:textColor="#00D9FF"
                android:background="@drawable/btn_neon"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/voice_key_delete"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Del"
                android:textColor="#00D9FF"
                android:background="@drawable/btn_neon"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/voice_key_word_fwd"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="50dp"
                android:layout_height="40dp"
                android:text="&gt;&gt;"
                android:textColor="#00D9FF"
                android:background="@drawable/btn_neon"
                android:layout_margin="4dp"/>

            <Button
                android:id="@+id/voice_key_cursor_right"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="&gt;"
                android:textColor="#00D9FF"
                android:background="@drawable/btn_neon"
                android:layout_margin="4dp"/>

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/voice_key_del_word"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="35dp"
                android:text="Del Word"
                android:textSize="12sp"
                android:textColor="#00D9FF"
                android:background="@drawable/btn_neon"
                android:layout_marginHorizontal="4dp"/>

             <Button
                android:id="@+id/voice_key_replace"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="35dp"
                android:text="Replace"
                android:textSize="12sp"
                android:textColor="#00D9FF"
                android:background="@drawable/btn_neon"
                android:layout_marginHorizontal="4dp"/>

             <Button
                android:id="@+id/voice_key_suggest"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="35dp"
                android:text="Suggest"
                android:textSize="12sp"
                android:textColor="#00D9FF"
                android:background="@drawable/btn_neon"
                android:layout_marginHorizontal="4dp"/>

            <Button
                android:id="@+id/voice_key_del_word_fwd"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="35dp"
                android:text="Fwd Del"
                android:textSize="12sp"
                android:textColor="#00D9FF"
                android:background="@drawable/btn_neon"
                android:layout_marginHorizontal="4dp"/>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/voice_key_sel_back"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="35dp"
                android:text="Sel Back"
                android:textSize="12sp"
                android:textColor="#00D9FF"
                android:background="@drawable/btn_neon"
                android:layout_marginHorizontal="4dp"/>

             <Button
                android:id="@+id/voice_key_sel_curr"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="35dp"
                android:text="Sel Word"
                android:textSize="12sp"
                android:textColor="#00D9FF"
                android:background="@drawable/btn_neon"
                android:layout_marginHorizontal="4dp"/>

             <Button
                android:id="@+id/voice_key_sel_fwd"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="35dp"
                android:text="Sel Fwd"
                android:textSize="12sp"
                android:textColor="#00D9FF"
                android:background="@drawable/btn_neon"
                android:layout_marginHorizontal="4dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/voice_key_space"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:text="Space"
            android:textColor="#00D9FF"
            android:background="@drawable/btn_neon"
            android:layout_marginHorizontal="24dp"/>

    </LinearLayout>

</FrameLayout>
