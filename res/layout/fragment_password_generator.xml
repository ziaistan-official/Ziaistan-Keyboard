<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password Generator"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/password_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="24sp"
        android:typeface="monospace"
        android:padding="16dp"
        android:background="?attr/selectableItemBackground"
        android:text="Password123"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/length_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Length: 16"
            android:layout_marginEnd="16dp"/>

        <SeekBar
            android:id="@+id/length_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <CheckBox
        android:id="@+id/check_lower"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lowercase (a-z)"
        android:checked="true"/>

    <CheckBox
        android:id="@+id/check_upper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Uppercase (A-Z)"
        android:checked="true"/>

    <CheckBox
        android:id="@+id/check_numbers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Numbers (0-9)"
        android:checked="true"/>

    <CheckBox
        android:id="@+id/check_symbols"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Symbols (!@#$)"
        android:checked="true"/>

    <CheckBox
        android:id="@+id/check_ambiguous"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Exclude Ambiguous (0, O, 1, l, I)"
        android:checked="false"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_generate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Generate"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_copy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Copy"/>
    </LinearLayout>

</LinearLayout>
