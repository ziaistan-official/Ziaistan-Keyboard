<?xml version="1.0" encoding="utf-8"?>
<juloo.keyboard2.GlyphPaneView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glyph_pane_root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="5dp"
    android:background="?attr/colorKeyboard">
  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Special Glyphs &amp; Symbols"
      android:padding="12dp"
      android:textSize="16sp"
      android:gravity="center_horizontal"
      />
  <HorizontalScrollView
      android:layout_width="match_parent"
      android:layout_height="wrap_content">
      <LinearLayout
          android:id="@+id/glyph_groups_bar"
          android:orientation="horizontal"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:padding="5dp">
      </LinearLayout>
  </HorizontalScrollView>
  <juloo.keyboard2.GlyphGridView
      android:id="@+id/glyph_grid"
      android:layout_width="fill_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:numColumns="10"
      android:background="?attr/colorKeyboard"
      android:verticalSpacing="10dp"
      android:horizontalSpacing="10dp"/>
  <juloo.keyboard2.Keyboard2View
      layout="@xml/emoji_bottom_row"
      android:layout_width="fill_parent"
      android:layout_height="wrap_content"
      android:background="?attr/emoji_key_bg"/>
</juloo.keyboard2.GlyphPaneView>
