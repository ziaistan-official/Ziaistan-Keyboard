<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorKeyboard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="?attr/colorKey">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Manual File GUI Editor"
            android:textColor="?attr/colorLabel"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/file_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="?attr/colorLabel" />
    </LinearLayout>

    <TextView
        android:id="@+id/path_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textColor="?attr/colorSubLabel"
        android:textSize="12sp"
        android:background="?attr/colorKeyboard" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/editor_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="?attr/colorKey">

        <Button
            android:id="@+id/btn_add_item"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add Item"
            android:textColor="?attr/colorLabel"
            android:background="?attr/colorKey" />

        <Button
            android:id="@+id/btn_bulk_ops"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Find/Replace"
            android:textColor="?attr/colorLabel"
            android:background="?attr/colorKey" />

        <Button
            android:id="@+id/btn_import"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Import &amp; Merge"
            android:textColor="?attr/colorLabel"
            android:background="?attr/colorKey" />

        <Button
            android:id="@+id/btn_save"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Save All"
            android:textColor="?attr/colorLabel"
            android:background="?attr/colorKey" />

    </LinearLayout>

</LinearLayout>
